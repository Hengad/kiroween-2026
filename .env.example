# Siloless engine settings. Copy this file to `.env` and edit it. Never commit `.env`.
# Every setting can also be given as an environment variable with the same name.

# Where data is stored. A file path for a local database, or "sqlite://" for memory only.
SILOLESS_DATABASE_URL=sqlite:///siloless.db

# Limits on what is accepted.
SILOLESS_MAX_RECORD_BYTES=262144
SILOLESS_MAX_QUERY_LENGTH=256

# Which Sources and document kinds count as authoritative (official). JSON lists.
# Only an authoritative Record can later answer a question on its own.
SILOLESS_AUTHORITATIVE_SOURCES=[]
SILOLESS_AUTHORITATIVE_KINDS=[]

# Entity types an application registers, for example ["machine", "stage"].
SILOLESS_ENTITY_TYPES=[]

# Extra relation types, added to the built-in ones (mentions, about, caused_by, resolves,
# answers, supersedes, duplicate_of, located_at).
SILOLESS_RELATION_TYPES=[]
